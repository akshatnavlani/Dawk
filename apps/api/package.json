{
  "name": "@dawk/api",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "db:ping": "bun --env-file=../../.env src/db-ping.ts",
    "db:migrate": "bun --env-file=../../.env src/migrate.ts up",
    "db:migrate:down": "bun --env-file=../../.env src/migrate.ts down",
    "db:test:schema": "bun --env-file=../../.env src/schema-constraints.ts",
    "test": "bun --env-file=../../.env test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "hono": "^4.13.13",
    "openai": "^7.31.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
