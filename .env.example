# Dawk environment names. Values stay empty here.
# Copy to .env (gitignored) and fill only what the current milestone needs.
# Never commit .env or real secrets.

# --- M0 / M2 (required to start the API) ---
# Postgres connection string for the local database.
DATABASE_URL=

# Signs session cookies. At least 32 characters. Must differ from CREDENTIALS_ENCRYPTION_KEY.
# Changing this value logs every session out.
SESSION_SECRET=

# Public web origin for local dev: http://127.0.0.1:3000 with no trailing slash.
# For a friend tunnel, set this to the https tunnel origin with no trailing slash.
APP_URL=

# Browser calls to the API. Leave blank for http://127.0.0.1:3001.
# Set to /api when a tunnel serves the web app and Next forwards /api to the API.
NEXT_PUBLIC_API_ORIGIN=

# Encrypts Owner provider keys. At least 32 characters. Must differ from SESSION_SECRET.
CREDENTIALS_ENCRYPTION_KEY=

# M2 Google OAuth client. Leave blank until a Google client exists.
# Redirect URI to register: http://127.0.0.1:3001/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# M10: Resend invite mail.
RESEND_API_KEY=
MAIL_FROM=

# M10: optional SMTP fallback (ADR-018). Not personal Gmail SMTP.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
